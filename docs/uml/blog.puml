@startuml

skinparam classAttributeIconSize 0

' --- Classes existantes ---

class Author {
  - id: Long
  - name: String
  - bio: String
  + createPost(title: String, content: String): Post
}

class Post {
  - id: Long
  - title: String
  - content: String
  - publishedAt: Date
  - isPublished: Boolean
  + publish(): Void
  + addComment(comment: Comment): Void
  + addTag(tag: Tag): Void
}

class Category {
  - id: Long
  - name: String
  - slug: String
}

class Comment {
  - id: Long
  - authorName: String
  - content: String
  - createdAt: Date
  - isApproved: Boolean
  + approve(): Void
}

' --- Nouvelles classes ajoutées ---

class Tag {
  - id: Long
  - label: String
  - slug: String
}

class Like {
  - id: Long
  - createdAt: Date
}

class Moderator {
  - id: Long
  - username: String
  - badgeNumber: String
  + reviewComment(comment: Comment): Void
  + deletePost(post: Post): Void
}

' --- Relations ---

Author "1" -- "*" Post : rédige >
Post "*" -- "*" Category : appartient à >
Post "1" *-- "*" Comment : reçoit >

' Nouveaux liens de relation
Post "*" -- "*" Tag : possède >
Post "1" *-- "*" Like : accumule >
Author "1" -- "*" Like : attribue >
Moderator "1" -- "*" Comment : modère >
Moderator "1" -- "*" Post : surveille >

@enduml
